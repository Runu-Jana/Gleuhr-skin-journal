# Server Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/gleuhr-app

# JWT Secret for token validation
JWT_SECRET=your_jwt_secret_here

# WhatsApp OTP via Interakt
INTERAKT_API_KEY=your_interakt_api_key_here
INTERAKT_API_URL=https://api.interakt.ai/v1/public/message/
INTERAKT_WHATSAPP_NUMBER=your_whatsapp_number_here

# Airtable Configuration (Diet Plan integration)
AIRTABLE_PAT=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_DIET_PLAN_TABLE=Diet Plan

# Admin credentials
ADMIN_EMAIL=admin@gleuhr.com
ADMIN_PASSWORD=change-this-password

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
